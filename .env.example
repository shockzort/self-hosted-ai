COMPOSE_PROJECT_NAME=self-hosted-ai

# Persistent state. Scripts resolve relative paths from the repository root
# before calling docker compose, so containers do not accidentally keep using
# the directory they were first created from.
SELF_HOSTED_AI_DATA_DIR=./data
SELF_HOSTED_AI_WORKFLOWS_DIR=./workflows

# Host user used for files created in SELF_HOSTED_AI_DATA_DIR.
PUID=1000
PGID=1000

# Public ports. Bind to 0.0.0.0 by default, so LAN clients can connect
# if the host firewall allows these ports.
COMFYUI_PORT=8188
OPEN_WEBUI_PORT=3000
OLLAMA_PORT=11434
RESULTS_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CADVISOR_PORT=8089
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400

# ComfyUI build/runtime.
COMFYUI_IMAGE=self-hosted-ai-comfyui
COMFYUI_IMAGE_TAG=local
COMFYUI_REF=master
COMFY_CUDA_IMAGE=nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
COMFYUI_EXTRA_ARGS=
COMFY_WORKFLOW_BUNDLE_ON_START=starter
COMFY_MODEL_BUNDLE_ON_START=
COMFYUI_INSTALL_EXTRA_REQUIREMENTS=1
COMFYUI_EXTRA_PIP_PACKAGES=sageattention
COMFYUI_REQUIREMENTS_CACHE=1
COMFYUI_REQUIREMENTS_PIP_ARGS="--timeout 60 --retries 5"
COMFYUI_REQUIREMENTS_SKIP=
COMFY_SHM_SIZE=16g
COMFY_CPUS=16
COMFY_MEM_LIMIT=96g
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
HF_HUB_ENABLE_HF_TRANSFER=1

# GPU visibility. Use "0" for a single GPU, "0,1" for two GPUs, or "all".
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
GPU_COUNT=all

# Ollama/Open WebUI.
OLLAMA_TAG=latest
OLLAMA_CPUS=16
OLLAMA_MEM_LIMIT=96g
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MODELS="qwen3:14b gemma3:12b deepseek-r1:14b"
OPEN_WEBUI_TAG=main
WEBUI_AUTH=true
OPEN_WEBUI_ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user
OPEN_WEBUI_ENABLE_PERSISTENT_CONFIG=true
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Dedicated llama.cpp server for local code agents.
CODE_LLM_PROFILE=gemma4-fast
CODE_LLM_PORT=8080
CODE_LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server
CODE_LLM_MAINLINE_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
CODE_LLM_MAINLINE_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
CODE_LLM_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
CODE_LLM_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
CODE_LLM_IK_GPU_IMAGE=self-hosted-ai-ik-llama.cpp:cuda
CODE_LLM_IK_CPU_IMAGE=self-hosted-ai-ik-llama.cpp:cpu
IK_LLAMA_CPP_REF=main
# Empty means 16 jobs in scripts/build-code-llm-engine.sh. CUDA 12.8 + ik_llama.cpp
# can segfault nvcc with very high parallelism; override if your toolchain is stable.
IK_LLAMA_BUILD_JOBS=
IK_LLAMA_DEFAULT_BUILD_JOBS=16
IK_LLAMA_CUDA_ARCHITECTURES=120
CODE_LLM_HF_REPO=noctrex/gemma-4-26B-A4B-it-MXFP4_MOE-GGUF:MXFP4_MOE
CODE_LLM_HF_FILE=gemma-4-26B-A4B-it-MXFP4_MOE.gguf
CODE_LLM_MODEL=
CODE_LLM_ALIAS=code/gemma4-fast
CODE_LLM_CTX_SIZE=32768
CODE_LLM_N_GPU_LAYERS=999
CODE_LLM_N_CPU_MOE=8
CODE_LLM_FLASH_ATTN=1
CODE_LLM_CACHE_TYPE_K=q8_0
CODE_LLM_CACHE_TYPE_V=q8_0
CODE_LLM_BATCH_SIZE=512
CODE_LLM_UBATCH_SIZE=512
CODE_LLM_PARALLEL=1
CODE_LLM_JINJA=1
CODE_LLM_REASONING=off
CODE_LLM_REASONING_BUDGET=
CODE_LLM_TEMP=0.7
CODE_LLM_TOP_P=0.8
CODE_LLM_TOP_K=20
CODE_LLM_MIN_P=0.0
CODE_LLM_PRESENCE_PENALTY=0.0
CODE_LLM_REPEAT_PENALTY=1.0
CODE_LLM_NO_MMAP=1
CODE_LLM_METRICS=1
CODE_LLM_API_KEY=
CODE_LLM_OVERRIDE_TENSORS=
CODE_LLM_CACHE_RAM=
CODE_LLM_EXTRA_ARGS=
CODE_LLM_CPUS=16
CODE_LLM_MEM_LIMIT=96g
CODE_LLM_SHM_SIZE=8g
OPEN_WEBUI_ENABLE_OPENAI_API=true
OPEN_WEBUI_OPENAI_API_BASE_URLS=http://code-llm:8080/v1
OPEN_WEBUI_OPENAI_API_KEYS=local-code-llm
OPEN_WEBUI_DEFAULT_MODELS=code/gemma4-fast
CODE_LLM_MANAGER_BIND=127.0.0.1
CODE_LLM_MANAGER_HOST=127.0.0.1
CODE_LLM_MANAGER_PORT=8091

# Monitoring.
PROMETHEUS_TAG=latest
GRAFANA_TAG=latest
CADVISOR_TAG=latest
NODE_EXPORTER_TAG=latest
DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter
DCGM_EXPORTER_TAG=4.5.2-4.8.1-distroless
DCGM_EXPORTER_AUTO_FALLBACK=1
DCGM_EXPORTER_FALLBACK_IMAGES="nvcr.io/nvidia/k8s/dcgm-exporter:4.5.3-4.8.2-distroless nvidia/dcgm-exporter:4.5.2-4.8.1-distroless"
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Smoke-test tuning for slow first boots with many custom nodes.
SMOKE_STATUS_EVERY=10
SMOKE_CURL_TIMEOUT=5
SMOKE_DELAY=2
SMOKE_COMFY_ATTEMPTS=300

# Optional Hugging Face token for gated models.
HF_TOKEN=
